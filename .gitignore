# -----------------------------------------------------------------------------
# Smart Tomato Garden — .gitignore (projeto acadêmico em evolução)
# Só listamos o que ignorar; o resto é versionado (docs, código, configs de exemplo).
# -----------------------------------------------------------------------------

# --- Segurança e ambiente local ---
.env
.env.local
.env.*.local
# Credenciais do firmware (versionar apenas secrets.example.h)
**/secrets.h
firmware/**/secrets.*.h
# Garantir que o template seja versionado
!firmware/**/secrets.example.h

# --- Python / ML ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
*.manifest

# Testes e qualidade (cache local)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# Dataset bruto e aumentado (grande demais para Git; regenerável)
ml/dataset/
dataset/
dataset_aug/
datasets/
tools/dataset/

# Versões antigas de modelos (substituídas por v0005)
ml/artifacts/model_registry/v0002/
ml/artifacts/model_registry/v0003/
ml/artifacts/model_registry/v0004/

# Cache de features de treino (regenerável via make docker-train)
ml/artifacts/model_registry/v0005/checkpoints/X_train.npy
ml/artifacts/model_registry/v0005/checkpoints/X_test.npy
ml/artifacts/model_registry/v0005/checkpoints/g_train.npy
ml/artifacts/model_registry/v0005/checkpoints/y_train_enc.npy
ml/artifacts/model_registry/v0005/checkpoints/y_test_enc.npy

# O restante de ml/artifacts/ é versionado:
#   model_registry/v0005/     — modelo clássico (XGBoost + ONNX)
#   model_registry/v0005_dl/  — modelo CNN (MobileNetV3)
#   validation/               — vetores de features para validate-parity
#   migration_benchmark.png   — comparativo Python vs Rust

# Experimentos e logs (MLflow, Wandb, outputs)
mlruns/
wandb/
runs/
outputs/
logs/
*.log
reports/
ml/reports/
salvas/
tmp/
temp/
*.tmp

# Jupyter (se usar notebooks no futuro)
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Firmware (ESP32 / PlatformIO) ---
# Build e cache do PlatformIO
.pio/
.pioenvs/
.piolibdeps/
*.bin
*.elf

# IDE/editor no firmware (configurações locais)
.vscode/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/

# --- Raiz / ferramentas ---
tools/**/output/

# --- Sistema e editor (raiz e subpastas) ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig

# Cursor / VSCode (opcional: remova a linha abaixo se quiser versionar .cursor)
.cursor/

# Dumps e artefatos gerados por scripts
dump_scripts.txt
**/dump_scripts.txt
**/artifacts_meta.json
**/artifacts_size.json
