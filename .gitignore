# -----------------------------------------------------------------------------
# Smart Tomato Garden — .gitignore (projeto acadêmico em evolução)
# Só listamos o que ignorar; o resto é versionado (docs, código, configs de exemplo).
# -----------------------------------------------------------------------------

# --- Segurança e ambiente local ---
.env
.env.local
.env.*.local
# Credenciais do firmware (versionar apenas secrets.example.h)
**/secrets.h
firmware/**/secrets.*.h
# Garantir que o template seja versionado
!firmware/**/secrets.example.h

# --- Python / ML ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
*.manifest

# Testes e qualidade (cache local)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# Dados e artefatos (pesados; descomente uma linha para versionar uma versão)
ml/dataset/
ml/artifacts/
dataset/
dataset_aug/
datasets/

# Experimentos e logs (MLflow, Wandb, outputs)
mlruns/
wandb/
runs/
outputs/
logs/
*.log
reports/
ml/reports/
salvas/
tmp/
temp/
*.tmp

# Jupyter (se usar notebooks no futuro)
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Firmware (ESP32 / PlatformIO) ---
# Build e cache do PlatformIO
.pio/
.pioenvs/
.piolibdeps/
*.bin
*.elf

# IDE/editor no firmware (configurações locais)
.vscode/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/

# --- Raiz / ferramentas ---
tools/dataset/
tools/**/output/

# --- Sistema e editor (raiz e subpastas) ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig

# Cursor / VSCode (opcional: remova a linha abaixo se quiser versionar .cursor)
.cursor/

# Dumps e artefatos gerados por scripts
dump_scripts.txt
**/dump_scripts.txt
**/artifacts_meta.json
**/artifacts_size.json
