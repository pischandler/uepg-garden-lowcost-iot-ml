# Copie para .env e ajuste se necessário.
# O docker-compose usa estas variáveis para a API e para o Makefile (via make vars).

# Caminho dos artefatos dentro do container (para a API)
GML_ARTIFACTS_DIR=/app/ml/artifacts/model_registry/v0004

# Porta da API no host (padrão 5000)
GML_PORT=5000

# Log e debug
GML_LOG_LEVEL=INFO
GML_SAVE_DEBUG=0
