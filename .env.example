# Copie para .env e ajuste conforme seu ambiente.
# O docker-compose e o Makefile leem estas variáveis automaticamente.

# ── Artefatos ────────────────────────────────────────────────────────────────
GML_ARTIFACTS_DIR=/app/ml/artifacts/model_registry/v0005
GML_ARTIFACTS_DIR_DL=/app/ml/artifacts/model_registry/v0005_dl

# ── Portas ────────────────────────────────────────────────────────────────────
GML_PORT=5000          # Python/Flask (produção)
GML_PORT_COMPARE=5001  # Python/Flask compare (clássico vs MobileNet)
GML_PORT_RUST=5002     # Rust/Axum

# ── Log e debug ───────────────────────────────────────────────────────────────
GML_LOG_LEVEL=INFO
GML_SAVE_DEBUG=0

# ── Fase 3: shadow mode ───────────────────────────────────────────────────────
# Habilita espelhamento de /predict para o servidor Rust em background.
# Ative após validar paridade: make validate-parity
GML_SHADOW_MODE=0
GML_SHADOW_URL=http://garden-ml-rust:5002   # nome do serviço Docker ou IP externo

# ── ESP32 (para make cutover-rust / make rollback-to-python) ─────────────────
DEVICE_IP=             # ex: 192.168.1.42
